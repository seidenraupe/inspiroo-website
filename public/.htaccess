# inspiroo.ch — Apache (KreativMedia/Plesk, Proxy-Modus Standard)
# Siehe https://help.kreativmedia.ch/de/nginx-reverseproxy/
# Bei «Statische Dateien direkt durch nginx» deaktivieren oder Weiterleitungen in Plesk setzen.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wix-Vorgänger → neue Struktur
  RewriteRule ^(übermich|uebermich)/?$ /ueber-mich/ [R=301,L,NC,B]
  RewriteRule ^projekte/?$ /referenzen/ [R=301,L,NC]

  # LinkedIn-Kurzlinks (Apache; Fallback: /check/ und /gespraech/ als HTML-Redirect)
  RewriteRule ^check/?$ /?utm_source=linkedin&utm_medium=social_organic&utm_campaign=website_relaunch_2026&utm_content=post_01_check#kurz-check [R=302,L,NE]
  RewriteRule ^gespraech/?$ /kontakt/?utm_source=linkedin&utm_medium=social_organic&utm_campaign=website_relaunch_2026&utm_content=post_01_kontakt [R=302,L,NE,QSA]
</IfModule>

# Fallback, falls mod_rewrite UTF-8-Pfade anders behandelt (URL-kodiertes «ü»)
RedirectMatch 301 ^/%C3%BCbermich/?$ /ueber-mich/