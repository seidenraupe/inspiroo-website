# Optional: leer lassen, wenn Analytics/Search Console noch nicht konfiguriert sind.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GitHub-Pages-Vorschau: /inspiroo-website — Produktion (KreativMedia): leer.
# Lokal: npm run build:pages-preview bzw. build:production (siehe package.json)
NEXT_PUBLIC_BASE_PATH=

# ── KreativMedia / Plesk — SFTP von lokal (nicht committen; wie andrezuraikat) ──
# Kopieren nach .env und Werte aus Plesk → FTP-Zugang eintragen.

# Hostname aus Plesk (Servername), nicht zwingend die IP
KREATIVMEDIA_SFTP_HOST=
# KreativMedia: SSH/SFTP laut FAQ Port 2121 (nicht 22)
KREATIVMEDIA_SFTP_PORT=2121
KREATIVMEDIA_SFTP_USER=
KREATIVMEDIA_SFTP_PASSWORD=
# Document Root der Domain in Plesk (z. B. httpdocs für www.inspiroo.ch)
KREATIVMEDIA_REMOTE_PATH=